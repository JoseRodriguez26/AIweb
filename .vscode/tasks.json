{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup (install everything)",
      "type": "shell",
      "command": "npm run setup",
      "problemMatcher": []
    },
    {
      "label": "Run AIweb (backend + app in browser)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run AIweb on my phone (Expo Go)",
      "type": "shell",
      "command": "EXPO_PUBLIC_API_URL=http://$(ipconfig getifaddr en0):3000 npm run dev:phone",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
